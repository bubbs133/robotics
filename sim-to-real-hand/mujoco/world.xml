<mujoco model="bionic_hand">
    <compiler angle="radian" />
    <option gravity="0 0 -9.81" />

    <asset>
        <texture type="skybox" name="sky" builtin="flat" rgb1="0.8 0.9 1" rgb2="0.8 0.9 1"
            width="512" height="512" />
        <material name="palm_mat" rgba="0.2 0.2 0.2 1" />
        <material name="finger_mat" rgba="0.9 0.6 0.2 1" />
    </asset>

    <worldbody>
        <geom type="plane" size="1 1 0.1" rgba="0.9 0.9 0.9 1" />
        <light pos="0 0 1.5" dir="0 0 -1" />

        <!-- Hand Palm Base (floating or fixed in space) -->
        <body name="palm" pos="0 0 0.6">
            <geom type="box" size="0.04 0.05 0.015" material="palm_mat" />

            <!-- 1. Thumb -->
            <body name="thumb_base" pos="-0.03 -0.03 -0.01">
                <joint name="thumb_joint" type="hinge" axis="0 1 0" range="-1.5 0.2" damping="0.1" />
                <geom type="capsule" size="0.012" fromto="0 0 0 -0.03 -0.03 -0.02"
                    material="finger_mat" />
            </body>

            <!-- 2. Index Finger -->
            <body name="index_base" pos="-0.02 0.05 0">
                <joint name="index_joint" type="hinge" axis="1 0 0" range="0 1.57" damping="0.1" />
                <geom type="capsule" size="0.01" fromto="0 0 0 0 0.04 0" material="finger_mat" />
            </body>

            <!-- 3. Middle Finger -->
            <body name="middle_base" pos="0 0.05 0">
                <joint name="middle_joint" type="hinge" axis="1 0 0" range="0 1.57" damping="0.1" />
                <geom type="capsule" size="0.01" fromto="0 0 0 0 0.045 0" material="finger_mat" />
            </body>

            <!-- 4. Ring Finger -->
            <body name="ring_base" pos="0.02 0.05 0">
                <joint name="ring_joint" type="hinge" axis="1 0 0" range="0 1.57" damping="0.1" />
                <geom type="capsule" size="0.01" fromto="0 0 0 0 0.04 0" material="finger_mat" />
            </body>

            <!-- 5. Pinky Finger -->
            <body name="pinky_base" pos="0.035 0.045 0">
                <joint name="pinky_joint" type="hinge" axis="1 0 0" range="0 1.57" damping="0.1" />
                <geom type="capsule" size="0.01" fromto="0 0 0 0 0.035 0" material="finger_mat" />
            </body>
        </body>
    </worldbody>

    <!-- Actuators to control each finger via data.ctrl -->
    <actuator>
        <motor joint="thumb_joint" gear="5" />
        <motor joint="index_joint" gear="5" />
        <motor joint="middle_joint" gear="5" />
        <motor joint="ring_joint" gear="5" />
        <motor joint="pinky_joint" gear="5" />
    </actuator>
</mujoco>